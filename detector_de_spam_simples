def separar_palavras(texto):
    texto = texto.lower()

    for simbolo in ".,!?;:/()[]{}@#$%&*-_":
        texto = texto.replace(simbolo, " ")

    return texto.split()

def treinar_modelo(dados):
    modelo = {"SPAM": {}, "SEGURO": {}}
    total_palavras = {"SPAM": 0, "SEGURO": 0}
    vocabulario = set()

    for email, classe in dados:
        palavras = separar_palavras(email)

        for palavra in palavras:
            vocabulario.add(palavra)

            if palavra not in modelo[classe]:
                modelo[classe][palavra] = 0

            modelo[classe][palavra] += 1
            total_palavras[classe] += 1

    return modelo, total_palavras, vocabulario

def classificar_email(email):
    palavras = separar_palavras(email)
    pontuacao = {"SPAM": 0, "SEGURO": 0}

    for classe in ["SPAM", "SEGURO"]:
        for palavra in palavras:
            quantidade = modelo[classe].get(palavra, 0) + 1
            total = total_palavras[classe] + len(vocabulario)
            pontuacao[classe] += math.log(quantidade / total)

    if pontuacao["SPAM"] > pontuacao["SEGURO"]:
        resultado = "SPAM"
    else:
        resultado = "SEGURO"

    diferenca = abs(pontuacao["SPAM"] - pontuacao["SEGURO"])
    confianca = min(99, round(50 + diferenca * 10))

    return resultado, confianca

